    "threshold": { "@id": "infrix:threshold", "@type": "xsd:nonNegativeInteger" },
    "CredentialRegistry": { "@id": "infrix:CredentialRegistry" },
    "LinkedData": { "@id": "infrix:LinkedData" },
    "InfrixContract": { "@id": "infrix:InfrixContract" },
    "InfrixAPI": { "@id": "infrix:InfrixAPI" },
    "description": { "@id": "https://schema.org/description" }
  }
